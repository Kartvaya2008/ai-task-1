# ─────────────────────────────────────────────
#  RAG API – Environment Configuration
# ─────────────────────────────────────────────

# LLM Provider – Groq (primary)
# Get your key at: https://console.groq.com  (keys start with gsk_)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# LLM Model (Groq-hosted open-source models)
LLM_MODEL=llama-3.3-70b-versatile

# LLM Provider – OpenRouter (fallback when Groq fails)
# Get your key at: https://openrouter.ai/keys  (keys start with sk-or-)
OPENROUTER_API_KEY="sk-or-your_openrouter_api_key_here"
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking config
CHUNK_SIZE=400
CHUNK_OVERLAP=80
TOP_K_RESULTS=5

# Rate limiting (requests per minute per IP)
RATE_LIMIT=20

# File upload config (bytes)
MAX_FILE_SIZE=10485760

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,https://your-app.vercel.app"

# Storage paths & Data Directory (leave DATA_DIR empty for local relative paths, set e.g. DATA_DIR=/var/data in production)
DATA_DIR=""
UPLOAD_DIR=uploads
FAISS_INDEX_PATH=vector_store/faiss_index
METADATA_PATH=vector_store/metadata.json
LOG_FILE=logs/rag.log

